{
  "name": "choubo-scan",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // ダッシュボードで設定した環境変数を wrangler deploy が消さないようにする
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 本番 (トップレベル) には D1 をまだ設定していない。
  //   → 本番では案件機能は無効 (API は 501・画面の案件パネルは非表示)。既存の読み取り機能だけが動く。
  // 本番で使うときは D1 を作成し、env.local と同じ d1_databases を実際の database_id でトップレベルに追加する。
  "env": {
    // ローカル開発専用: npx wrangler dev --env local
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "choubo-scan-local",
          "database_id": "local-only",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
